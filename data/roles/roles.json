{
    "_meta": {
        "version": 1,
        "status": "DRAFT - perlu direview manusia sebelum dipakai",
        "model_token_limit": 128,
        "template_note": "Template dijaga pendek (sekitar 50 kata) agar muat di 128 token model embedding. Verifikasi jumlah token dengan tokenizer model, bukan dengan hitungan kata.",
        "matching_rule": "Cocokkan alias pada teks yang hanya di-lowercase dan spasinya dirapatkan (jangan pakai clean_text(), karena simbol +, #, . penting untuk c#, .net, node.js). Pola regex: (?<![a-z0-9+#.])ALIAS_ESCAPED(?![a-z0-9+#]).",
        "language_note": "Alias Indonesia dan Inggris digabung dalam satu entri. Id skill memakai istilah Inggris."
    },
    "roles": {
        "backend": {
            "label": "Backend Developer",
            "templates": {
                "id": "Backend Developer: merancang, membangun, dan memelihara aplikasi sisi server serta REST API menggunakan Python, Java, atau Node.js. Bekerja dengan database SQL dan NoSQL, autentikasi, pengujian, Docker, dan deployment cloud. Pengalaman pengembangan software, perancangan sistem, dan kolaborasi tim untuk memecahkan masalah teknis menjadi nilai tambah.",
                "en": "Backend Developer: design, build, and maintain server-side applications and REST APIs using Python, Java, or Node.js. Work with SQL and NoSQL databases, authentication, testing, Docker, and cloud deployment. Experience in software development, system design, and collaborating with a team to solve technical problems is a plus."
            },
            "core_skills": [
                "rest_api",
                "docker",
                "auth",
                "backend_testing",
                "git",
                "api_design"
            ],
            "core_groups": [
                "backend_language",
                "database_any"
            ]
        },
        "frontend": {
            "label": "Frontend Developer",
            "templates": {
                "id": "Frontend Developer: membangun antarmuka pengguna web yang responsif dan mudah diakses menggunakan HTML, CSS, JavaScript, dan TypeScript dengan React, Vue, atau Angular. Mengintegrasikan REST API, mengelola state aplikasi, mengimplementasikan desain UI/UX dari Figma, dan menulis pengujian komponen. Pengalaman optimasi performa web serta kolaborasi dengan desainer dan backend engineer menjadi nilai tambah.",
                "en": "Frontend Developer: build responsive, accessible user interfaces for web applications using HTML, CSS, JavaScript, and TypeScript with React, Vue, or Angular. Integrate REST APIs, manage application state, implement UI/UX designs from Figma, and write component tests. Experience in web performance and collaborating with designers and backend engineers is a plus."
            },
            "core_skills": [
                "html",
                "css",
                "javascript",
                "responsive_design",
                "rest_api",
                "git",
                "frontend_testing"
            ],
            "core_groups": [
                "frontend_framework"
            ]
        }
    },
    "groups": {
